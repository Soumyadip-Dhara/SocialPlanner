FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /app

COPY Gatherly.slnx .
COPY src/Gatherly.Contracts/Gatherly.Contracts.csproj src/Gatherly.Contracts/
COPY src/Gatherly.Repositories/Gatherly.Repositories.csproj src/Gatherly.Repositories/
COPY src/Gatherly.Services/Gatherly.Services.csproj src/Gatherly.Services/
COPY src/Gatherly.Api/Gatherly.Api.csproj src/Gatherly.Api/
COPY Directory.Build.props .

RUN dotnet restore src/Gatherly.Api/Gatherly.Api.csproj

COPY src/ src/

RUN dotnet publish src/Gatherly.Api/Gatherly.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

RUN addgroup --gid 1001 gatherly \
    && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" gatherly \
    && chown -R gatherly:gatherly /app
USER gatherly

EXPOSE 8080
ENTRYPOINT ["dotnet", "Gatherly.Api.dll"]
