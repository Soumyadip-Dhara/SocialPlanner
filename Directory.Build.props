<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Pin EF Core to a single consistent version across all projects -->
  <ItemGroup>
    <PackageReference Update="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="9.0.20" />
    <PackageReference Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>
</Project>
